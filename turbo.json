{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },

    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": []
    },

    "lint": {
      "outputs": []
    },

    "lint:fix": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
